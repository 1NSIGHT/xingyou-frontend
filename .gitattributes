# 统一换行符处理，避免 Windows/macOS/Linux 协作时全文件 diff
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

package-lock.json  -diff linguist-generated
